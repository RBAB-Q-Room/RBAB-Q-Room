}

function toInt_(v, dflt) {
  const n = parseInt(String(v === null || v === undefined ? '' : v).trim(), 10);
  return isNaN(n) ? (dflt === undefined ? 0 : dflt) : n;
}

/** Signed byte array (what Utilities returns) -> lowercase hex. */
function bytesToHex_(bytes) {
  let out = '';
